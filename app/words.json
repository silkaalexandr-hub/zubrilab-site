[["still","всё ещё; до сих пор; тем не менее",0,1,"She is still at work.","Она всё ещё на работе."],["look","смотреть; выглядеть; взгляд",0,1,"You look tired today.","Ты сегодня выглядишь уставшим."],["own","собственный; владеть",[["owner","владелец"],["ownership","владение"]],1,"I want my own room.","Я хочу свою собственную комнату."],["during","во время, в течение",0,1,"He fell asleep during the film.","Он уснул во время фильма."],["sure","уверенный; конечно",[["unsure","неуверенный"]],1,"Are you sure about that?","Ты в этом уверен?"],["feel (felt, felt)","чувствовать; ощущать",[["feeling","чувство"]],1,"I feel much better now.","Сейчас я чувствую себя гораздо лучше."],["might","может быть; мог бы",0,1,"It might rain later.","Позже, возможно, пойдёт дождь."],["ever","когда-либо; когда-нибудь",0,1,"Have you ever been to Paris?","Ты когда-нибудь был в Париже?"],["free","свободный; бесплатный",[["freedom","свобода"]],1,"The museum is free on Sundays.","По воскресеньям музей бесплатный."],["different","разный; другой, отличающийся",[["difference","разница"]],1,"We have different opinions.","У нас разные мнения."],["however","однако; тем не менее",0,1,"It was cold. However, we went out.","Было холодно. Однако мы вышли на улицу."],["government","правительство",0,1,"The government raised taxes.","Правительство повысило налоги."],["care","забота; заботиться",[["careful","осторожный"],["careless","небрежный"]],1,"Take care of yourself.","Береги себя."],["case","случай; дело; чехол",0,1,"In that case, I'll call you later.","В таком случае я позвоню тебе позже."],["point","точка; смысл; указывать",[["pointless","бессмысленный"]],1,"What's the point of waiting?","Какой смысл ждать?"],["yet","ещё (не); уже (в вопросе); однако",0,1,"I haven't finished yet.","Я ещё не закончил."],["change","менять; изменение; сдача",0,1,"Keep the change.","Сдачи не нужно."],["mean (meant, meant)","значить, иметь в виду",[["meaning","значение"]],1,"What do you mean?","Что ты имеешь в виду?"],["once","однажды; один раз; как только",0,1,"Call me once you arrive.","Позвони мне, как только приедешь."],["support","поддержка; поддерживать",0,1,"Thanks for your support.","Спасибо за поддержку."],["though","хотя; всё же",0,1,"It's late, though I'm not tired.","Уже поздно, хотя я не устал."],["service","обслуживание; услуга; служба",0,1,"The service here is excellent.","Обслуживание здесь отличное."],["order","порядок; заказ; заказывать; приказ",[["disorder","беспорядок"]],1,"Are you ready to order?","Вы готовы сделать заказ?"],["run (ran, run)","бежать; управлять (делом)",[["runner","бегун"]],1,"She runs a small café.","Она управляет небольшим кафе."],["country","страна; сельская местность",0,1,"They moved to another country.","Они переехали в другую страну."],["general","общий; генерал",[["generally","в целом, обычно"]],1,"In general, I agree with you.","В целом я с тобой согласен."],["area","район; область; площадь",0,1,"We live in a quiet area.","Мы живём в тихом районе."],["law","закон; право",[["lawyer","юрист"]],1,"It's against the law.","Это противозаконно."],["whole","весь, целый",0,1,"I spent the whole day at home.","Я провёл весь день дома."],["kind","добрый; вид, сорт",[["kindness","доброта"],["unkind","недобрый"]],1,"What kind of music do you like?","Какую музыку ты любишь?"],["within","в пределах; в течение",0,1,"We'll reply within two days.","Мы ответим в течение двух дней."],["health","здоровье",[["healthy","здоровый"]],1,"Sleep is important for your health.","Сон важен для здоровья."],["early","рано; ранний",0,1,"I get up early on weekdays.","В будни я встаю рано."],["local","местный",0,1,"We buy vegetables at the local market.","Мы покупаем овощи на местном рынке."],["able","способный; be able to — мочь",[["unable","неспособный"],["ability","способность"]],1,"Will you be able to come?","Ты сможешь прийти?"],["single","единственный; одинокий; холостой",0,1,"He didn't say a single word.","Он не сказал ни единого слова."],["level","уровень",0,1,"What's your level of English?","Какой у тебя уровень английского?"],["mind","разум; возражать (do you mind)",0,1,"Do you mind if I open the window?","Ты не против, если я открою окно?"],["several","несколько",0,1,"I've read it several times.","Я прочитал это несколько раз."],["wrong","неправильный; не так",0,1,"Something is wrong with my phone.","С моим телефоном что-то не так."],["research","исследование; исследовать",[["researcher","исследователь"]],1,"New research shows the opposite.","Новое исследование показывает обратное."],["almost","почти",0,1,"It's almost midnight.","Уже почти полночь."],["pretty","довольно; симпатичный",0,1,"The test was pretty easy.","Тест был довольно лёгким."],["matter","иметь значение; дело, вопрос",0,1,"It doesn't matter.","Это не имеет значения."],["past","прошлое; прошлый; мимо",0,1,"We walked past the old church.","Мы прошли мимо старой церкви."],["possible","возможный",[["impossible","невозможный"],["possibility","возможность"]],1,"Is it possible to change the date?","Можно ли изменить дату?"],["move","двигаться; переезжать; ход",0,1,"We moved here last year.","Мы переехали сюда в прошлом году."],["cause","причина; вызывать, быть причиной",0,1,"What caused the delay?","Что стало причиной задержки?"],["due","должный; ожидаемый; due to — из-за",0,1,"The train was late due to snow.","Поезд опоздал из-за снега."],["watch","смотреть, наблюдать; часы",0,1,"We watched a film last night.","Вчера вечером мы смотрели фильм."],["leave (left, left)","уходить, уезжать; оставлять",0,1,"Don't leave your bag here.","Не оставляй здесь свою сумку."],["special","особый, особенный",0,1,"Today is a special day.","Сегодня особенный день."],["either","любой (из двух); тоже (не)",0,1,"I don't like it either.","Мне это тоже не нравится."],["stay","оставаться; останавливаться (в отеле)",0,1,"We stayed at a small hotel.","Мы остановились в небольшом отеле."],["future","будущее; будущий",0,1,"Nobody knows the future.","Никто не знает будущего."],["deal (dealt, dealt)","сделка; иметь дело (with)",0,1,"I'll deal with it tomorrow.","Я разберусь с этим завтра."],["rather","скорее; довольно; would rather — предпочёл бы",0,1,"I'd rather stay at home.","Я бы лучше остался дома."],["whether","ли (в косвенном вопросе)",0,1,"I don't know whether he's coming.","Я не знаю, придёт ли он."],["soon","скоро",0,1,"See you soon!","До скорого!"],["report","доклад, отчёт; сообщать",0,1,"I need to finish the report.","Мне нужно закончить отчёт."],["reason","причина; разум",[["reasonable","разумный"]],1,"There's no reason to worry.","Нет причин волноваться."],["buy (bought, bought)","покупать",[["buyer","покупатель"]],1,"I bought a new jacket.","Я купил новую куртку."],["turn","поворачивать; очередь",0,1,"Turn left at the corner.","На углу поверните налево."],["further","дальше; дальнейший",0,1,"For further details, call us.","За подробностями звоните нам."],["check","проверять; чек, счёт",0,1,"Can you check my spelling?","Можешь проверить мою орфографию?"],["major","главный, крупный",[["majority","большинство"]],1,"It was a major mistake.","Это была крупная ошибка."],["although","хотя",0,1,"Although it was late, we kept working.","Хотя было поздно, мы продолжали работать."],["quite","довольно; вполне",0,1,"The film was quite good.","Фильм был довольно хорошим."],["former","бывший; прежний",0,1,"He is a former teacher.","Он бывший учитель."],["available","доступный; свободный (о человеке)",[["unavailable","недоступный"],["availability","наличие"]],1,"Is this room available?","Этот номер свободен?"],["bring (brought, brought)","приносить; привозить",0,1,"Bring your passport.","Возьмите с собой паспорт."],["current","текущий, нынешний",[["currently","в настоящее время"]],1,"What's your current address?","Какой у вас текущий адрес?"],["meet (met, met)","встречать; знакомиться",[["meeting","встреча, собрание"]],1,"Nice to meet you.","Приятно познакомиться."],["experience","опыт; испытывать",[["experienced","опытный"]],1,"She has a lot of experience.","У неё большой опыт."],["clear","ясный, понятный; убирать",[["unclear","неясный"],["clearly","ясно, очевидно"]],1,"Is everything clear?","Всё понятно?"],["across","через, поперёк; на другой стороне",0,1,"The bank is across the street.","Банк на другой стороне улицы."],["instead","вместо этого; instead of — вместо",0,1,"Let's take a taxi instead.","Давай лучше возьмём такси."],["cost (cost, cost)","стоить; стоимость",0,1,"How much does it cost?","Сколько это стоит?"],["issue","вопрос, проблема; выпуск",0,1,"We discussed several issues.","Мы обсудили несколько вопросов."],["fine","хорошо, в порядке; штраф",0,1,"I got a fine for parking.","Я получил штраф за парковку."],["rest","отдых; остаток; отдыхать",0,2,"You need some rest.","Тебе нужно отдохнуть."],["miss","скучать; пропускать; опаздывать (на транспорт)",0,2,"I missed the bus.","Я опоздал на автобус."],["include","включать (в себя)",[["including","включая"]],2,"Breakfast is included.","Завтрак включён."],["similar","похожий, подобный",[["similarity","сходство"]],2,"Our jobs are very similar.","Наша работа очень похожа."],["especially","особенно",0,2,"I love summer, especially July.","Я люблю лето, особенно июль."],["lead (led, led)","вести; руководить",[["leader","лидер, руководитель"]],2,"This road leads to the river.","Эта дорога ведёт к реке."],["perfect","идеальный, совершенный",[["perfectly","отлично, идеально"]],2,"Your English is perfect.","У тебя идеальный английский."],["allow","позволять, разрешать",0,2,"Smoking is not allowed here.","Здесь курить запрещено."],["among","среди, между (многими)",0,2,"She was among the best students.","Она была среди лучших студентов."],["probably","вероятно, наверное",[["probable","вероятный"]],2,"He's probably at home.","Он, наверное, дома."],["offer","предлагать; предложение",0,2,"They offered me a job.","Мне предложили работу."],["remain","оставаться",0,2,"Please remain seated.","Пожалуйста, оставайтесь на местах."],["suggest","предлагать, советовать",[["suggestion","предложение"]],2,"I suggest we leave now.","Предлагаю уйти сейчас."],["realize","осознавать, понимать",0,2,"I didn't realize it was so late.","Я не понимал, что уже так поздно."],["explain","объяснять",[["explanation","объяснение"]],2,"Can you explain this rule?","Можешь объяснить это правило?"],["expect","ожидать; рассчитывать",[["unexpected","неожиданный"]],2,"I didn't expect to see you here.","Не ожидал увидеть тебя здесь."],["decide","решать, принимать решение",[["decision","решение"]],2,"We decided to stay.","Мы решили остаться."],["describe","описывать",[["description","описание"]],2,"Describe your ideal job.","Опиши свою идеальную работу."],["improve","улучшать(ся)",[["improvement","улучшение"]],2,"I want to improve my English.","Я хочу улучшить свой английский."],["avoid","избегать",0,2,"Try to avoid sugar.","Старайся избегать сахара."],["prevent","предотвращать",[["prevention","предотвращение"]],2,"We can prevent this problem.","Мы можем предотвратить эту проблему."],["neglect","пренебрегать; запускать",0,2,"Don't neglect your health.","Не пренебрегай своим здоровьем."],["admire","восхищаться",[["admiration","восхищение"]],2,"I admire your patience.","Я восхищаюсь твоим терпением."],["reluctant","неохотный; делающий через силу",[["reluctance","неохота"],["reluctantly","неохотно"]],2,"He was reluctant to leave so early.","Ему не хотелось уходить так рано."],["curious","любопытный",[["curiosity","любопытство"]],2,"Children are naturally curious.","Дети от природы любопытны."],["afford","позволить себе (по деньгам)",[["affordable","доступный по цене"]],2,"We can't afford a new car.","Мы не можем позволить себе новую машину."],["borrow","брать взаймы, одалживать (у кого-то)",0,2,"Can I borrow your pen?","Можно взять твою ручку?"],["lend (lent, lent)","давать взаймы, одалживать (кому-то)",0,2,"Could you lend me some money?","Не одолжишь мне немного денег?"],["complain","жаловаться",[["complaint","жалоба"]],2,"She always complains about the weather.","Она вечно жалуется на погоду."],["enough","достаточно; достаточный",0,2,"Do we have enough time?","У нас достаточно времени?"],["hardly","едва, почти не",0,2,"I can hardly hear you.","Я тебя почти не слышу."],["rely","полагаться, рассчитывать (on)",[["reliable","надёжный"]],2,"You can rely on me.","Ты можешь на меня положиться."],["worth","стоящий; be worth — стоить (того)",0,2,"The film is worth watching.","Этот фильм стоит посмотреть."],["apologize","извиняться",[["apology","извинение"]],2,"I apologize for the delay.","Прошу прощения за задержку."],["achieve","достигать",[["achievement","достижение"]],2,"She achieved her goal.","Она достигла своей цели."],["purpose","цель, назначение; on purpose — нарочно",0,2,"He did it on purpose.","Он сделал это нарочно."],["advice","совет",[["advise","советовать"]],2,"Can I give you some advice?","Можно дать тебе совет?"]]